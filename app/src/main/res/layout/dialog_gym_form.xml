<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <EditText
            android:id="@+id/inputGymName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_name_hint"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <EditText
            android:id="@+id/inputGymLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_location_hint"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_latitude"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/inputLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_longitude"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned" />

        <TextView
            android:id="@+id/locationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/retryLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/chooseLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_on_map" />

        <EditText
            android:id="@+id/inputGymPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_price_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputGymOpeningHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_opening_hours_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputGymFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_facilities_hint"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/inputGymClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gym_classes_hint"
            android:inputType="textCapSentences" />

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="@string/gym_photo_preview"
            android:scaleType="centerInside" />

        <Button
            android:id="@+id/pickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gym_choose_photo" />

    </LinearLayout>
</ScrollView>